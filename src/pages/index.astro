---
const juegos = [
  { nombre: "Minecraft", genero: "Sandbox", imagen: "https://sc.filehippo.net/images/t_app-icon-l/p/b276c62c-96bf-11e6-ad7b-00163ec9f5fa/2418235042/minecraft-logo" },
  { nombre: "FIFA 24", genero: "Deportes", imagen: "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQBwHnW5AYeo5NcjFdvlkJRE1ClbnN6_zMZgA&s" },
  { nombre: "Call of Duty", genero: "Shooter", imagen: "https://i.pinimg.com/236x/2c/93/7a/2c937a981e324eadb7ba452d4db51612.jpg" },
];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Catálogo de Videojuegos</title>

    <style>
      body {
        font-family: Arial;
        margin: 0;
        background: white;
        color: black;
        transition: 0.3s;
      }

      header {
        padding: 20px;
        text-align: center;
        background: #eee;
      }

      h1 {
        margin: 0;
      }

      button {
        margin-top: 10px;
        padding: 10px 15px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        padding: 20px;
      }

      .card {
        background: #f2f2f2;
        padding: 10px;
        border-radius: 10px;
        text-align: center;
        transition: 0.2s;
      }

      .card:hover {
        transform: scale(1.05);
      }

      img {
        width: 100%;
        border-radius: 10px;
      }

      body.dark {
        background: #111;
        color: white;
      }

      body.dark header {
        background: #222;
      }

      body.dark .card {
        background: #1e1e1e;
      }

      input {
        padding: 10px;
        margin-top: 10px;
        border-radius: 10px;
        border: none;
        width: 200px;
        }

        .card {
          background: #f2f2f2;
          padding: 10px;
          border-radius: 10px;
          text-align: center;
          transition: 0.2s;
          max-width: 220px;
          margin: auto;
          }
          .card:hover {
            transform: scale(1.03);
          }
          .filters {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin: 20px;
            }
            .filters button {
              padding: 8px 12px;
              border: none;
              border-radius: 10px;
              cursor: pointer;
              background: #444;
              color: white;
              }
              
              .filters button:hover {
                background: #666;
                }
    </style>
  </head>

  <body>
    <header>
      <h1>Catálogo de Videojuegos</h1>
      <button onclick="toggleDark()">🌙 Modo oscuro</button>
      <input type="text" id="searchInput" placeholder="🔍 Buscar juego..." />
    </header>
    <div class="filters">
  <button onclick="filterGames('all')">Todos</button>
  <button onclick="filterGames('Sandbox')">Sandbox</button>
  <button onclick="filterGames('RPG')">RPG</button>
  <button onclick="filterGames('Shooter')">Shooter</button>
  <button onclick="filterGames('Deportes')">Deportes</button>
  <button onclick="filterGames('Puzzle')">Puzzle</button>
  <button onclick="filterGames('Estrategia')">Estrategia</button>
  </div>

<section class="grid">
  {juegos.map(juego => (
    <div class="card" data-genero={juego.genero}>
      <img src={juego.imagen} alt={juego.nombre} />
      <h3>{juego.nombre}</h3>
      <p>{juego.genero}</p>
    </div>
  ))}
</section>

<script is:inline>
  window.filterGames = function (genero) {
    const cards = document.querySelectorAll(".card");

    cards.forEach(card => {
      const tipo = card.dataset.genero;

      if (genero === "all" || tipo === genero) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  };

  const input = document.getElementById("searchInput");

  input.addEventListener("input", () => {
    const value = input.value.toLowerCase();

    document.querySelectorAll(".card").forEach(card => {
      const text = card.innerText.toLowerCase();

      card.style.display = text.includes(value) ? "block" : "none";
    });
  });
</script>