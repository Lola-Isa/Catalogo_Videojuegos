---
import { games, genres } from "../data/games.js";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Catalogo de Videojuegos</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
      :root {
        color-scheme: light;
        font-family: Arial, Helvetica, sans-serif;
        --background: #f6f7fb;
        --surface: #ffffff;
        --surface-soft: #eceff5;
        --text: #15171c;
        --muted: #626a78;
        --primary: #4f46e5;
        --primary-strong: #3730a3;
        --danger: #b42318;
        --border: #d7dce5;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        transition: background 0.2s ease, color 0.2s ease;
      }

      body.dark {
        color-scheme: dark;
        --background: #101114;
        --surface: #191b20;
        --surface-soft: #252932;
        --text: #f4f6fb;
        --muted: #a9b0bd;
        --border: #353a45;
      }

      a {
        color: inherit;
      }

      .topbar {
        align-items: center;
        background: #111318;
        color: #ffffff;
        display: flex;
        gap: 12px;
        justify-content: space-between;
        padding: 14px 24px;
      }

      .brand {
        font-weight: 700;
      }

      .nav-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
      }

      .session-label {
        color: #d7dce5;
        font-size: 14px;
      }

      .button,
      button {
        align-items: center;
        background: var(--surface-soft);
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--text);
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        gap: 8px;
        justify-content: center;
        min-height: 40px;
        padding: 9px 14px;
        text-decoration: none;
      }

      .topbar .button,
      .topbar button {
        background: #2b303b;
        color: #ffffff;
      }

      .button.primary,
      button.primary {
        background: var(--primary);
        color: #ffffff;
      }

      .button.primary:hover,
      button.primary:hover {
        background: var(--primary-strong);
      }

      .button.ghost,
      button.ghost {
        background: transparent;
        border-color: var(--border);
      }

      .hero {
        background: linear-gradient(135deg, #111318, #383c46);
        color: #ffffff;
        padding: 72px 24px 42px;
        text-align: center;
      }

      .hero h1 {
        font-size: 36px;
        line-height: 1.1;
        margin: 0 auto 12px;
        max-width: 720px;
      }

      .hero p {
        color: #d7dce5;
        margin: 0 auto;
        max-width: 640px;
      }

      .toolbar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: grid;
        gap: 18px;
        padding: 22px 24px;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      }

      .search {
        background: var(--surface-soft);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font: inherit;
        min-height: 40px;
        min-width: min(320px, 100%);
        padding: 9px 12px;
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: center;
      }

      .filter-button.active {
        background: var(--primary);
        color: #ffffff;
      }

      .status {
        color: var(--muted);
        font-size: 14px;
        min-height: 22px;
        text-align: center;
      }

      .status.error {
        color: var(--danger);
      }

      .layout {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 1fr) 300px;
        margin: 0 auto;
        max-width: 1240px;
        padding: 32px 24px;
      }

      .grid {
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      }

      .card,
      .favorites-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      .card {
        display: grid;
        gap: 10px;
        overflow: hidden;
      }

      .card img {
        aspect-ratio: 4 / 3;
        background: var(--surface-soft);
        object-fit: cover;
        width: 100%;
      }

      .card-content {
        display: grid;
        gap: 8px;
        padding: 0 14px 14px;
      }

      .card h3 {
        font-size: 18px;
        margin: 0;
      }

      .card p {
        color: var(--muted);
        margin: 0;
      }

      .favorite-button.is-favorite {
        background: #fee4a3;
        color: #352400;
      }

      .favorites-panel {
        align-self: start;
        display: grid;
        gap: 12px;
        padding: 18px;
        position: sticky;
        top: 18px;
      }

      .favorites-panel h2 {
        font-size: 20px;
        margin: 0;
      }

      .favorites-list {
        display: grid;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .favorites-list li {
        background: var(--surface-soft);
        border-radius: 8px;
        padding: 9px 10px;
      }

      .empty {
        color: var(--muted);
        margin: 0;
      }

      footer {
        background: #111318;
        color: #ffffff;
        padding: 28px;
        text-align: center;
      }

      @media (max-width: 860px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .favorites-panel {
          position: static;
        }
      }

      @media (max-width: 620px) {
        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .nav-actions {
          justify-content: flex-start;
        }

        .hero h1 {
          font-size: 28px;
        }
      }
    </style>
  </head>

  <body>
    <nav class="topbar">
      <span class="brand">Catalogo de Videojuegos</span>
      <div class="nav-actions">
        <span id="session-label" class="session-label">Revisando sesion...</span>
        <a id="login-link" href="/login" class="button">Ingresar</a>
        <a id="register-link" href="/registro" class="button primary">Crear cuenta</a>
        <button id="logout-button" class="ghost" type="button" hidden>Cerrar sesion</button>
      </div>
    </nav>

    <section class="hero">
      <h1>Descubri nuevos videojuegos y guarda tus favoritos</h1>
      <p>
        Busca por nombre, filtra por genero y arma una lista personal para volver a encontrar
        tus juegos elegidos.
      </p>
    </section>

    <header class="toolbar">
      <section class="controls" aria-label="Controles del catalogo">
        <button id="dark-mode-button" type="button">Modo oscuro</button>
        <input id="search-input" class="search" type="search" placeholder="Buscar juego..." />
      </section>

      <div class="filters" aria-label="Filtros por genero">
        {
          genres.map((genre) => (
            <button
              class:list={["filter-button", { active: genre === "all" }]}
              type="button"
              data-filter={genre}
            >
              {genre === "all" ? "Todos" : genre}
            </button>
          ))
        }
      </div>

      <p id="status-message" class="status">Los favoritos se guardan en la nube al iniciar sesion.</p>
    </header>

    <main class="layout">
      <section id="games-grid" class="grid" aria-label="Lista de videojuegos">
        {
          games.map((game) => (
            <article class="card" data-game-card data-game-id={game.id} data-genre={game.genre}>
              <img src={game.image} alt={`Portada de ${game.name}`} loading="lazy" />
              <div class="card-content">
                <h3>{game.name}</h3>
                <p>{game.genre}</p>
                <button class="favorite-button" type="button" data-favorite-button data-game-id={game.id}>
                  Agregar a favoritos
                </button>
              </div>
            </article>
          ))
        }
      </section>

      <aside class="favorites-panel" aria-label="Juegos favoritos">
        <h2>Mis favoritos</h2>
        <p id="favorites-empty" class="empty">Todavia no agregaste favoritos.</p>
        <ul id="favorites-list" class="favorites-list"></ul>
      </aside>
    </main>

    <footer>
      <p>Hecho con Astro, JavaScript y Supabase</p>
    </footer>

    <script define:vars={{ supabaseUrl, supabaseAnonKey, games }}>
      const LOCAL_STORAGE_KEY = "catalogo-videojuegos-favoritos";
      const cards = Array.from(document.querySelectorAll("[data-game-card]"));
      const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
      const favoriteButtons = Array.from(document.querySelectorAll("[data-favorite-button]"));
      const searchInput = document.getElementById("search-input");
      const statusMessage = document.getElementById("status-message");
      const favoritesList = document.getElementById("favorites-list");
      const favoritesEmpty = document.getElementById("favorites-empty");
      const sessionLabel = document.getElementById("session-label");
      const loginLink = document.getElementById("login-link");
      const registerLink = document.getElementById("register-link");
      const logoutButton = document.getElementById("logout-button");
      const darkModeButton = document.getElementById("dark-mode-button");

      let activeGenre = "all";
      let favoriteIds = [];
      let currentUser = null;
      let supabaseClient = null;

      function setStatus(message, isError = false) {
        statusMessage.textContent = message;
        statusMessage.classList.toggle("error", isError);
      }

      function getLocalFavorites() {
        try {
          return JSON.parse(localStorage.getItem(LOCAL_STORAGE_KEY)) || [];
        } catch {
          return [];
        }
      }

      function saveLocalFavorites(ids) {
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(ids));
      }

      function renderCatalog() {
        const searchValue = searchInput.value.trim().toLowerCase();

        cards.forEach((card) => {
          const genre = card.dataset.genre;
          const text = card.textContent.toLowerCase();
          const matchesGenre = activeGenre === "all" || genre === activeGenre;
          const matchesSearch = text.includes(searchValue);
          card.hidden = !(matchesGenre && matchesSearch);
        });
      }

      function renderFavorites() {
        const favoriteSet = new Set(favoriteIds);
        const selectedGames = games.filter((game) => favoriteSet.has(game.id));

        favoriteButtons.forEach((button) => {
          const isFavorite = favoriteSet.has(button.dataset.gameId);
          button.classList.toggle("is-favorite", isFavorite);
          button.textContent = isFavorite ? "Quitar de favoritos" : "Agregar a favoritos";
          button.setAttribute("aria-pressed", isFavorite ? "true" : "false");
        });

        favoritesEmpty.hidden = selectedGames.length > 0;
        favoritesList.innerHTML = selectedGames
          .map((game) => `<li><strong>${game.name}</strong><br /><span>${game.genre}</span></li>`)
          .join("");
      }

      async function loadCloudFavorites() {
        const { data, error } = await supabaseClient
          .from("favorites")
          .select("game_id")
          .eq("user_id", currentUser.id);

        if (error) {
          setStatus("No se pudieron cargar los favoritos de Supabase. Se usa guardado local.", true);
          favoriteIds = getLocalFavorites();
          return;
        }

        favoriteIds = data.map((favorite) => favorite.game_id);
      }

      async function saveCloudFavorite(gameId, shouldSave) {
        if (!currentUser || !supabaseClient) {
          saveLocalFavorites(favoriteIds);
          setStatus("Favoritos guardados solo en este navegador. Inicia sesion para guardarlos en la nube.");
          return;
        }

        if (shouldSave) {
          const { error } = await supabaseClient.from("favorites").insert({
            user_id: currentUser.id,
            game_id: gameId,
          });

          if (error) {
            setStatus("No se pudo guardar el favorito en Supabase.", true);
          }
          return;
        }

        const { error } = await supabaseClient
          .from("favorites")
          .delete()
          .eq("user_id", currentUser.id)
          .eq("game_id", gameId);

        if (error) {
          setStatus("No se pudo quitar el favorito en Supabase.", true);
        }
      }

      async function toggleFavorite(gameId) {
        const isFavorite = favoriteIds.includes(gameId);
        favoriteIds = isFavorite
          ? favoriteIds.filter((id) => id !== gameId)
          : [...favoriteIds, gameId];

        renderFavorites();
        await saveCloudFavorite(gameId, !isFavorite);
      }

      async function initializeSession() {
        if (window.supabase && supabaseUrl && supabaseAnonKey) {
          supabaseClient = window.supabase.createClient(supabaseUrl, supabaseAnonKey);
          const { data } = await supabaseClient.auth.getUser();
          currentUser = data.user;
        }

        if (currentUser) {
          sessionLabel.textContent = currentUser.email;
          loginLink.hidden = true;
          registerLink.hidden = true;
          logoutButton.hidden = false;
          await loadCloudFavorites();
          setStatus("Favoritos sincronizados con Supabase.");
        } else {
          sessionLabel.textContent = "Sin sesion";
          favoriteIds = getLocalFavorites();
          setStatus("Podes probar favoritos localmente. Para nube, inicia sesion.");
        }

        renderFavorites();
      }

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeGenre = button.dataset.filter;
          filterButtons.forEach((item) => item.classList.toggle("active", item === button));
          renderCatalog();
        });
      });

      favoriteButtons.forEach((button) => {
        button.addEventListener("click", () => toggleFavorite(button.dataset.gameId));
      });

      searchInput.addEventListener("input", renderCatalog);

      darkModeButton.addEventListener("click", () => {
        document.body.classList.toggle("dark");
      });

      logoutButton.addEventListener("click", async () => {
        if (supabaseClient) {
          await supabaseClient.auth.signOut();
        }
        window.location.reload();
      });

      initializeSession();
    </script>
  </body>
</html>
