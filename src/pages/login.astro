---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ingresar | Catalogo de Videojuegos</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
      body {
        align-items: center;
        background: #f6f7fb;
        color: #15171c;
        display: flex;
        font-family: Arial, Helvetica, sans-serif;
        justify-content: center;
        margin: 0;
        min-height: 100vh;
        padding: 24px;
      }

      .panel {
        background: #ffffff;
        border: 1px solid #d7dce5;
        border-radius: 8px;
        display: grid;
        gap: 16px;
        max-width: 420px;
        padding: 28px;
        width: 100%;
      }

      h1,
      p {
        margin: 0;
      }

      p {
        color: #626a78;
      }

      form {
        display: grid;
        gap: 12px;
      }

      input,
      button {
        border-radius: 8px;
        font: inherit;
        min-height: 42px;
        padding: 10px 12px;
      }

      input {
        border: 1px solid #cfd5df;
      }

      button {
        background: #4f46e5;
        border: 0;
        color: #ffffff;
        cursor: pointer;
      }

      a {
        color: #4f46e5;
      }

      .message {
        min-height: 22px;
      }

      .message.error {
        color: #b42318;
      }

      .message.success {
        color: #067647;
      }
    </style>
  </head>

  <body>
    <main class="panel">
      <div>
        <h1>Ingresar</h1>
        <p>Inicia sesion para sincronizar tus favoritos con Supabase.</p>
      </div>

      <form id="login-form">
        <input type="email" name="email" placeholder="Email" autocomplete="email" required />
        <input
          type="password"
          name="password"
          placeholder="Contrasena"
          autocomplete="current-password"
          required
        />
        <button type="submit">Entrar</button>
      </form>

      <p id="message" class="message"></p>
      <a href="/registro">Crear cuenta</a>
      <a href="/">Volver al catalogo</a>
    </main>

    <script define:vars={{ supabaseUrl, supabaseAnonKey }}>
      const form = document.getElementById("login-form");
      const message = document.getElementById("message");

      function showMessage(text, type) {
        message.textContent = text;
        message.className = `message ${type}`;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!window.supabase || !supabaseUrl || !supabaseAnonKey) {
          showMessage("Faltan las variables de Supabase en Vercel o en .env.", "error");
          return;
        }

        const formData = new FormData(form);
        const email = formData.get("email");
        const password = formData.get("password");
        const client = window.supabase.createClient(supabaseUrl, supabaseAnonKey);

        const { error } = await client.auth.signInWithPassword({
          email,
          password,
        });

        if (error) {
          showMessage(`Error: ${error.message}`, "error");
          return;
        }

        showMessage("Sesion iniciada. Redirigiendo al catalogo...", "success");
        window.setTimeout(() => {
          window.location.href = "/";
        }, 800);
      });
    </script>
  </body>
</html>
